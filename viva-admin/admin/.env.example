# Firebase Configuration Example
# Copy this file to firebase-service-account.json and fill in your credentials

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase Service Account Email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Firebase Private Key (paste your key here, replace actual newlines with \n)
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour private key\n-----END PRIVATE KEY-----\n

# Backend Configuration
SERVER_PORT=8080
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRATION_HOURS=24

# Database (Firestore - configured via Firebase)
SPRING_CLOUD_GCP_PROJECT_ID=your-firebase-project-id

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_ADMIN=DEBUG
